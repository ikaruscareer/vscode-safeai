{
  "name": "safeai-vscode",
  "displayName": "SafeAI",
  "description": "Offline-first SafeAI security and governance scanning for AI-agent codebases.",
  "version": "0.2.0",
  "publisher": "ikaruscareer",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ikaruscareer/vscode-safeai.git"
  },
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Linters", "Security"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "safeai.scanWorkspace", "title": "SafeAI: Scan Workspace", "icon": "$(shield)" },
      { "command": "safeai.scanCurrentFile", "title": "SafeAI: Scan Current File" },
      { "command": "safeai.clearResults", "title": "SafeAI: Clear Results" },
      { "command": "safeai.refresh", "title": "SafeAI: Refresh Results", "icon": "$(refresh)" },
      { "command": "safeai.openSettings", "title": "SafeAI: Open Settings" }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "safeai",
          "title": "SafeAI",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "safeai": [
        {
          "id": "safeaiFindings",
          "name": "Findings",
          "icon": "$(shield)",
          "contextualTitle": "SafeAI Findings"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        { "command": "safeai.scanWorkspace", "when": "workspaceFolderCount > 0" },
        { "command": "safeai.scanCurrentFile", "when": "editorIsOpen" },
        { "command": "safeai.clearResults" },
        { "command": "safeai.refresh" },
        { "command": "safeai.openSettings" }
      ],
      "view/title": [
        { "command": "safeai.refresh", "when": "view == safeaiFindings", "group": "navigation" },
        { "command": "safeai.clearResults", "when": "view == safeaiFindings" }
      ],
      "codeAction": [
        {
          "command": "safeai.showRemediation",
          "when": "diagnosticSource == SafeAI",
          "group": "safeai"
        }
      ]
    },
    "configuration": {
      "title": "SafeAI",
      "properties": {
        "safeai.cliPath": {
          "type": "string",
          "default": "safeai",
          "description": "Path to the SafeAI executable. Leave empty to use python module fallback."
        },
        "safeai.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python executable used for the SafeAI module fallback."
        },
        "safeai.severityThreshold": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"],
          "default": "low",
          "description": "Lowest finding severity displayed by the extension."
        },
        "safeai.extraArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Additional SafeAI CLI arguments."
        },
        "safeai.timeout": {
          "type": "number",
          "default": 120000,
          "description": "Scan timeout in milliseconds."
        },
        "safeai.autoScan": {
          "type": "boolean",
          "default": false,
          "description": "Automatically scan workspace on file save."
        },
        "safeai.autoScanDebounce": {
          "type": "number",
          "default": 1000,
          "description": "Debounce interval in milliseconds for auto-scan."
        },
        "safeai.scanOnSavePatterns": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["**/*"],
          "description": "Glob patterns for files that trigger auto-scan on save."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "lint": "eslint src test --ext .ts",
    "test": "vitest run",
    "package": "npm run compile && npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vscode/vsce": "^3.2.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
